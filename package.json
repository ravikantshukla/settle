{
  "name": "settle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke:invoice": "tsx scripts/smoke-invoice.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "build:render": "node scripts/prisma-postgres.mjs check && prisma generate --schema prisma/postgres/schema.prisma && next build",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:pg": "node scripts/prisma-postgres.mjs migrate",
    "start:render": "prisma migrate deploy --schema prisma/postgres/schema.prisma && next start",
    "setup": "prisma migrate deploy && npm run db:seed",
    "eval:injection": "tsx scripts/eval-injection.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "^6.19.3",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "next": "15.5.28",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/env": "^15.5.28",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "license": "MIT",
  "description": "AI collections agent for freelancers: AI-drafted PayPal invoices, approval-gated reminders, payment plans and subcontractor payouts."
}
