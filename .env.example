# PayPal (sandbox) — https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Database: SQLite locally, Postgres on Render
DATABASE_URL="file:./dev.db"

# Public base URL of the app (used for links and webhook docs)
APP_BASE_URL=http://localhost:3000

# Shared secret for the scheduled agent endpoint: POST /api/cron/agent with "Authorization: Bearer <CRON_SECRET>"
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Sandbox *personal* accounts (developer.paypal.com → Testing Tools → Sandbox Accounts).
# Buyer: in DEMO_MODE every invoice is sent here; also used by scripts/smoke-invoice.ts.
SANDBOX_BUYER_EMAIL=
# Two more sandbox personal accounts that receive subcontractor payouts in DEMO_MODE.
SANDBOX_SUB1_EMAIL=
SANDBOX_SUB2_EMAIL=

# Demo mode: sends every invoice/payout to the sandbox accounts above, shows the demo clock and a
# "Reset demo" button (which DELETES ALL local data and creates fresh sandbox invoices).
# Set to false to send invoices to the real extracted client emails (still on the sandbox API).
DEMO_MODE=true
