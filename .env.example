# PayPal (sandbox) — https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Database: SQLite locally, Postgres on Render
DATABASE_URL="file:./dev.db"

# Public base URL of the app (used for links and webhook docs)
APP_BASE_URL=http://localhost:3000

# Shared secret for the scheduled agent endpoint: POST /api/cron/agent with "Authorization: Bearer <CRON_SECRET>"
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Sandbox *personal* (buyer) account email, used by scripts/smoke-invoice.ts
SANDBOX_BUYER_EMAIL=
